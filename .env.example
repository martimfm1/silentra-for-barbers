# Silentra for Barbers — environment template
# Never commit real values. Configure secrets separately in Vercel/GitHub/Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# Manual billing price overrides. Values are in EUR and are snapshotted when a request is created.
MANUAL_PRICE_PRO_MONTHLY_EUR=
MANUAL_PRICE_PRO_YEARLY_EUR=
MANUAL_PRICE_ENTERPRISE_MONTHLY_EUR=
MANUAL_PRICE_ENTERPRISE_YEARLY_EUR=

# Platform administrator allowlist. In production, configure the stable user ID; when both ID and email are set, both must match.
SILENTRA_PLATFORM_ADMIN_USER_ID=
SILENTRA_PLATFORM_ADMIN_EMAIL=
# Optional: use a dedicated Stripe Customer Portal configuration.
# Leave empty to use the account's default portal configuration.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Silentra
BREVO_SMS_SENDER=
BREVO_WEBHOOK_SECRET=

# Protect scheduled workers. Use a random secret with at least 32 bytes of entropy.
CRON_SECRET=

# Required for production abuse protection. Use a random secret with at least 32 bytes of entropy.
RATE_LIMIT_SECRET=

# Optional/public application settings
NEXT_PUBLIC_APP_URL=https://barbers.silentra.me
NEXT_PUBLIC_SITE_URL=https://barbers.silentra.me
QA_BASE_URL=http://127.0.0.1:3000

# Configure only if the corresponding integrations are enabled in this deployment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=